---
import '../styles/polebug.css';
import 'katex/dist/katex.min.css';
import siteData from '../data/generated.json';

interface Props {
  title?: string;
  description?: string;
  activeNav?: string;
  wide?: boolean;
}

const {
  title,
  description = siteData.site?.description || '',
  activeNav = 'about',
  wide = false,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (p: string) => `${baseUrl}/${p.replace(/^\/+/, '')}`;

const pageTitle = title
  ? `${title} · ${siteData.site?.name || 'Blog'}`
  : siteData.site?.title || 'Blog';

const defaultTheme = siteData.site?.defaultTheme || 'light';
const avatarUrl = siteData.site?.avatarUrl;
const monogram = (siteData.site?.name || 'H').slice(0, 1).toUpperCase();
const sections = siteData.sections || [];
const searchIndex = siteData.searchIndex || [];
---

<!doctype html>
<html lang="zh-CN" data-theme={defaultTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Noto+Serif+SC:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline define:vars={{ defaultTheme }}>
      {
        let theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        const finalTheme = theme === 'light' || theme === 'dark' ? theme : defaultTheme;
        if (finalTheme === 'light') {
          document.documentElement.dataset.theme = 'light';
        } else {
          delete document.documentElement.dataset.theme;
        }
      }
    </script>
  </head>
  <body>
    <div class="site-header-wrap" id="site-header-wrap">
      <header class="site-header">
        <a class="brand-link" href={withBase('')} aria-label="Home">
          <span class="site-mark">
            {avatarUrl ? (
              <img src={avatarUrl} alt={siteData.site?.name || 'Avatar'} width="42" height="42" />
            ) : (
              <span>{monogram}</span>
            )}
          </span>
          <span class="brand-name">{siteData.site?.name || 'HuangYul'}</span>
        </a>
        <nav aria-label="Main navigation">
          <a href={withBase('')} aria-current={activeNav === 'about' ? 'page' : undefined}>
            About
          </a>
          {sections.map((sec) => (
            <a
              href={withBase(`${sec.id}/`)}
              aria-current={activeNav === sec.id ? 'page' : undefined}
            >
              {sec.navLabel}
            </a>
          ))}
          {siteData.site?.github && (
            <a href={siteData.site.github} target="_blank" rel="noopener">
              GitHub<span class="ext-arrow" aria-hidden="true">↗</span>
            </a>
          )}
          <button
            type="button"
            class="search-trigger"
            id="open-search-btn"
            title="全站搜索 (Ctrl + K)"
            aria-label="Open search"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-3.5-3.5" />
            </svg>
            <span>搜索</span>
            <span class="search-kbd">⌘K</span>
          </button>
          <button
            type="button"
            class="theme-toggle"
            title="切换亮色 / 暗色主题"
            aria-label="Toggle dark / light theme"
          >
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
            </svg>
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          </button>
        </nav>
      </header>
    </div>

    <main class={wide ? 'wide' : ''}>
      <slot />
    </main>

    <!-- Full-Site Ctrl+K Search Modal -->
    <div class="search-backdrop" id="search-backdrop" role="dialog" aria-modal="true" aria-label="全站搜索">
      <div class="search-modal" id="search-modal">
        <div class="search-input-row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" />
          </svg>
          <input
            type="text"
            class="search-input"
            id="search-input"
            placeholder="搜索文章标题、标签、算法或 AI 笔记内容..."
            autocomplete="off"
          />
          <button type="button" class="search-close-btn" id="close-search-btn">ESC</button>
        </div>
        <div class="search-results" id="search-results"></div>
      </div>
    </div>

    <!-- Image Lightbox Overlay -->
    <div class="lightbox-overlay" id="lightbox-overlay" role="dialog" aria-label="图片放大预览">
      <img id="lightbox-img" src="" alt="" />
      <div class="lightbox-caption" id="lightbox-caption"></div>
    </div>

    <footer class="site-footer">
      <span>© {new Date().getFullYear()} {siteData.site?.name || 'HuangYul'} · {siteData.site?.motto}</span>
      <span>Powered by Obsidian & Astro</span>
    </footer>

    <script is:inline define:vars={{ searchIndex, baseUrl }}>
      // 1. Sticky Header Scroll Border
      const headerWrap = document.getElementById('site-header-wrap');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 12) {
          headerWrap?.classList.add('scrolled');
        } else {
          headerWrap?.classList.remove('scrolled');
        }
      }, { passive: true });

      // 2. Theme Toggle
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const isLight = document.documentElement.dataset.theme === 'light';
        const nextTheme = isLight ? 'dark' : 'light';
        if (nextTheme === 'light') {
          document.documentElement.dataset.theme = 'light';
        } else {
          delete document.documentElement.dataset.theme;
        }
        try {
          localStorage.setItem('theme', nextTheme);
        } catch {}
        window.dispatchEvent(new CustomEvent('theme-changed', { detail: { theme: nextTheme } }));
      });

      // 3. Code Block Copy Button
      document.addEventListener('click', async (e) => {
        const btn = e.target.closest('.code-copy-btn');
        if (!btn) return;
        const wrapper = btn.closest('.code-block-wrapper');
        const codeEl = wrapper?.querySelector('pre code');
        if (!codeEl) return;
        try {
          await navigator.clipboard.writeText(codeEl.textContent || '');
          const orig = btn.textContent;
          btn.textContent = '✓ 已复制';
          btn.classList.add('copied');
          setTimeout(() => {
            btn.textContent = orig;
            btn.classList.remove('copied');
          }, 1800);
        } catch {}
      });

      // 4. Image Lightbox Zoom
      const lightbox = document.getElementById('lightbox-overlay');
      const lightboxImg = document.getElementById('lightbox-img');
      const lightboxCap = document.getElementById('lightbox-caption');

      document.addEventListener('click', (e) => {
        const img = e.target.closest('img[data-zoomable="true"]');
        if (img && lightbox && lightboxImg) {
          lightboxImg.src = img.src;
          lightboxImg.alt = img.alt || '';
          if (lightboxCap) lightboxCap.textContent = img.alt || '';
          lightbox.classList.add('open');
        }
      });

      lightbox?.addEventListener('click', () => {
        lightbox.classList.remove('open');
      });

      // 5. Full-Site Ctrl+K Search Modal
      const searchBackdrop = document.getElementById('search-backdrop');
      const searchInput = document.getElementById('search-input');
      const searchResults = document.getElementById('search-results');
      let selectedHitIndex = 0;

      function escapeHtmlStr(s) {
        return String(s || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;');
      }

      function highlightKeyword(text, kw) {
        if (!kw) return escapeHtmlStr(text);
        const safeText = escapeHtmlStr(text);
        const escapedKw = kw.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        return safeText.replace(new RegExp(`(${escapedKw})`, 'gi'), '<mark>$1</mark>');
      }

      function renderSearchHits(query) {
        if (!searchResults) return;
        const q = (query || '').trim().toLowerCase();
        const items = !q
          ? searchIndex.slice(0, 10)
          : searchIndex.filter((item) => {
              return (
                item.title.toLowerCase().includes(q) ||
                (item.sourceLabel && item.sourceLabel.toLowerCase().includes(q)) ||
                (item.searchText && item.searchText.toLowerCase().includes(q))
              );
            }).slice(0, 20);

        selectedHitIndex = 0;
        if (items.length === 0) {
          searchResults.innerHTML = `<div class="search-empty">未找到与 “${escapeHtmlStr(query)}” 相关的笔记</div>`;
          return;
        }

        searchResults.innerHTML = items
          .map((item, idx) => {
            let snippet = item.summary || '';
            if (q && item.searchText) {
              const pos = item.searchText.toLowerCase().indexOf(q);
              if (pos !== -1) {
                const start = Math.max(0, pos - 30);
                const end = Math.min(item.searchText.length, pos + 90);
                snippet = (start > 0 ? '…' : '') + item.searchText.slice(start, end) + (end < item.searchText.length ? '…' : '');
              }
            }
            const href = `${baseUrl}/post/${item.slug}/`;
            return `<a class="search-hit ${idx === 0 ? 'selected' : ''}" href="${href}">
              <div class="search-hit-top">
                <span class="search-hit-title">${highlightKeyword(item.title, q)}</span>
                <span class="search-hit-badge">${escapeHtmlStr(item.sectionTitle)} · ${escapeHtmlStr(item.sourceLabel)}</span>
              </div>
              <p class="search-hit-snippet">${highlightKeyword(snippet, q)}</p>
            </a>`;
          })
          .join('');
      }

      function openSearch() {
        searchBackdrop?.classList.add('open');
        renderSearchHits(searchInput?.value || '');
        setTimeout(() => searchInput?.focus(), 30);
      }

      function closeSearch() {
        searchBackdrop?.classList.remove('open');
      }

      document.getElementById('open-search-btn')?.addEventListener('click', openSearch);
      document.getElementById('close-search-btn')?.addEventListener('click', closeSearch);
      searchBackdrop?.addEventListener('click', (e) => {
        if (e.target === searchBackdrop) closeSearch();
      });

      searchInput?.addEventListener('input', (e) => {
        renderSearchHits(e.target.value);
      });

      window.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          if (searchBackdrop?.classList.contains('open')) {
            closeSearch();
          } else {
            openSearch();
          }
        } else if (e.key === 'Escape') {
          closeSearch();
          lightbox?.classList.remove('open');
        } else if (searchBackdrop?.classList.contains('open')) {
          const hits = Array.from(searchResults?.querySelectorAll('.search-hit') || []);
          if (hits.length === 0) return;
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            selectedHitIndex = (selectedHitIndex + 1) % hits.length;
            hits.forEach((h, i) => h.classList.toggle('selected', i === selectedHitIndex));
            hits[selectedHitIndex]?.scrollIntoView({ block: 'nearest' });
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            selectedHitIndex = (selectedHitIndex - 1 + hits.length) % hits.length;
            hits.forEach((h, i) => h.classList.toggle('selected', i === selectedHitIndex));
            hits[selectedHitIndex]?.scrollIntoView({ block: 'nearest' });
          } else if (e.key === 'Enter' && hits[selectedHitIndex]) {
            e.preventDefault();
            window.location.href = hits[selectedHitIndex].getAttribute('href');
          }
        }
      });
    </script>
  </body>
</html>
