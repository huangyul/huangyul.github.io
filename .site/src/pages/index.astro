---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteData from '../data/generated.json';

const { site, home } = siteData;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (p: string) => `${baseUrl}/${p.replace(/^\/+/, '')}`;

const techStack = home?.techStack || [
  'TypeScript',
  'Vue',
  'React',
  'Go',
  'Node.js',
  'AI Agent',
  'Algorithms',
];

const blogSection = (siteData.sections || []).find(
  (sec: any) => sec.type === 'blog' || sec.id === 'blog'
);
const recentBlogPosts = (blogSection?.posts || []).slice(0, 5);
---

<BaseLayout activeNav="about">
  <div class="intro-house">
    <section class="intro" aria-label="About">
      <h1 class="name">About</h1>
      <p class="motto">{site?.motto}</p>
      {home?.hello && <p class="hello">{home.hello}</p>}

      <div class="tech-badges" aria-label="Core Tech Stack">
        {techStack.map((tag: string) => (
          <span class="tech-badge">{tag}</span>
        ))}
      </div>

      {(home?.paragraphs || []).map((para: string) => <p>{para}</p>)}

      {home?.career && home.career.length > 0 && (
        <>
          {home.careerTitle && <p>{home.careerTitle}</p>}
          <ul class="career">
            {home.career.map((item: { title: string; detail: string }) => (
              <li>
                <strong>{item.title}</strong>: {item.detail}
              </li>
            ))}
          </ul>
        </>
      )}

      {home?.outro && <p>{home.outro}</p>}
      {home?.signature && <p class="signature">{home.signature}</p>}
    </section>

    {recentBlogPosts.length > 0 && (
      <section class="home-recent" aria-label="Recent blog posts">
        <div class="home-recent-head">
          <h2 class="home-recent-title">Recent Posts</h2>
          <a class="home-recent-all" href={withBase('blog/')}>
            All posts →
          </a>
        </div>
        <ul class="archive-list">
          {recentBlogPosts.map((item: any) => (
            <li>
              <time class="home-recent-time" datetime={item.dateIso}>{item.dateYMD}</time>
              <a href={withBase(`post/${item.slug}/`)}>{item.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>
