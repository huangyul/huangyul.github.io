---
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteData from '../../data/generated.json';

export function getStaticPaths() {
  const posts = siteData.posts || [];
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (p: string) => `${baseUrl}/${p.replace(/^\/+/, '')}`;

const hasToc = Array.isArray(post.headings) && post.headings.length > 1;
const hasSiblingTree = Boolean(post.siblingTree && post.siblingTree.folders?.length);
const hasBacklinks = Array.isArray(post.backlinks) && post.backlinks.length > 0;

const layoutClasses = [
  'reader-layout',
  hasSiblingTree ? 'three-col' : '',
  !hasToc ? 'no-toc' : '',
]
  .filter(Boolean)
  .join(' ');
---

<BaseLayout
  title={post.title}
  description={post.summary}
  activeNav={post.sectionId}
  wide={hasToc || hasSiblingTree}
  bodyClass="post-detail-page"
>
  <!-- Top Reading Progress Bar -->
  <div class="reading-progress" aria-hidden="true">
    <div class="reading-progress-bar" id="reading-progress-bar"></div>
  </div>

  <div class={layoutClasses}>
    {/* Left Sidebar: Sibling Chapter Tree (Minimalist Editorial Index) */}
    {hasSiblingTree && (
      <aside class="chapter-sidebar" aria-label="Chapter navigation">
        <div class="chapter-sidebar-head">
          <a
            class="chapter-sidebar-title"
            href={withBase(`${post.sectionId}/?domain=${encodeURIComponent(post.sourceRoot || '')}`)}
          >
            {post.siblingTree.label}
          </a>
          <span class="chapter-sidebar-count">
            {post.siblingTree.totalCount} {post.siblingTree.totalCount === 1 ? 'note' : 'notes'}
          </span>
        </div>
        {post.siblingTree.folders.map((folder: any) => (
          <div class="chapter-folder" data-sidebar-folder>
            <button
              type="button"
              class="chapter-folder-toggle"
              data-sidebar-folder-toggle
              aria-expanded="true"
            >
              <span class="folder-chevron" aria-hidden="true">▾</span>
              <span class="chapter-folder-name">{folder.folderName}</span>
              <span class="chapter-folder-count">{folder.items.length}</span>
            </button>
            <ul class="chapter-list">
              {folder.items.map((item: any, idx: number) => (
                <li>
                  <a
                    href={withBase(`post/${item.slug}/`)}
                    aria-current={item.slug === post.slug ? 'page' : undefined}
                  >
                    <span class="chapter-item-idx">{String(idx + 1).padStart(2, '0')}</span>
                    <span class="chapter-item-text">{item.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </aside>
    )}

    {/* Center Column: Article Content */}
    <article class="reader-article">
      <nav class="reader-head" aria-label="Breadcrumb">
        <div class="reader-breadcrumb">
          <a class="back-link" href={withBase(`${post.sectionId}/`)}>
            ← {post.sectionTitle}
          </a>
          {post.sourceLabel && post.sectionId === 'notes' && (
            <>
              <span class="crumb-sep" aria-hidden="true">/</span>
              <a
                class="crumb-link"
                href={withBase(`${post.sectionId}/?domain=${encodeURIComponent(post.sourceRoot || '')}`)}
              >
                {post.sourceLabel}
              </a>
            </>
          )}
          {post.subFolder && (
            <>
              <span class="crumb-sep" aria-hidden="true">/</span>
              <span class="crumb-current">{post.subFolder}</span>
            </>
          )}
        </div>
      </nav>

      <header class="article-header">
        <h1 class="article-title">{post.title}</h1>
        <div class="article-meta">
          <time datetime={post.dateIso}>{post.dateYMD}</time>
          <span class="meta-sep" aria-hidden="true">·</span>
          <span>{post.wordCount?.toLocaleString() || 0} words</span>
          <span class="meta-sep" aria-hidden="true">·</span>
          <span>{post.readingMinutes || 1} min</span>
          {siteData.site?.counterApiUrl && (
            <span class="page-views-wrap" id="page-views-wrap" style="display:none;">
              <span class="meta-sep" aria-hidden="true">·</span>
              <span class="post-views" title="Article views">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7Z" />
                  <circle cx="12" cy="12" r="3" />
                </svg>
                <span><strong id="page-pv">--</strong> views</span>
              </span>
            </span>
          )}
          {post.tags && post.tags.length > 0 && (
            <>
              <span class="meta-sep" aria-hidden="true">·</span>
              <span class="article-tags">
                {post.tags.map((t: string) => (
                  <span class="article-tag">#{t}</span>
                ))}
              </span>
            </>
          )}
        </div>
      </header>

      <div class="article-body" id="article-body" set:html={post.html} />

      {/* Backlinks Section */}
      {hasBacklinks && (
        <section class="backlinks-box" aria-label="Backlinks">
          <h3 class="backlinks-title">Notes linking here ({post.backlinks.length})</h3>
          <div class="backlinks-grid">
            {post.backlinks.map((bl: any) => (
              <a class="backlink-card" href={withBase(`post/${bl.slug}/`)}>
                <h4>{bl.title}</h4>
                <span>{bl.sectionTitle} · {bl.dateYMD}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      {/* Prev / Next Navigation */}
      {(post.prev || post.next) && (
        <nav class="post-nav" aria-label="Previous and next posts">
          {post.prev ? (
            <a class="prev" href={withBase(`post/${post.prev.slug}/`)}>
              <span class="post-nav-label">← Previous</span>
              <span class="post-nav-title">{post.prev.title}</span>
            </a>
          ) : (
            <div />
          )}
          {post.next ? (
            <a class="next" href={withBase(`post/${post.next.slug}/`)}>
              <span class="post-nav-label">Next →</span>
              <span class="post-nav-title">{post.next.title}</span>
            </a>
          ) : (
            <div />
          )}
        </nav>
      )}
    </article>

    {/* Right Column: Sticky Table of Contents with ScrollSpy */}
    {hasToc && (
      <aside class="toc-aside" aria-label="Table of contents">
        <h2 class="toc-title">On this page</h2>
        <ul class="toc-list" id="toc-list">
          {post.headings.map((h: { depth: number; text: string; id: string }) => (
            <li class={`depth-${h.depth}`}>
              <a href={`#${h.id}`} data-toc-id={h.id}>
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </div>

  {/* Floating Action Buttons (Mobile Drawer Trigger & Back to Top) */}
  <div class="fab-group">
    {(hasToc || hasSiblingTree) && (
      <button
        type="button"
        class="fab-btn mobile-only"
        id="open-drawer-btn"
        title="Open contents drawer"
        aria-label="Open directory drawer"
      >
        ☰
      </button>
    )}
    <button
      type="button"
      class="fab-btn scroll-top-btn"
      id="scroll-top-btn"
      title="Back to top"
      aria-label="Scroll to top"
    >
      ↑
    </button>
  </div>

  {/* Mobile Drawer for TOC & Chapter Tree */}
  {(hasToc || hasSiblingTree) && (
    <div class="mobile-drawer-backdrop" id="mobile-drawer-backdrop" role="dialog" aria-modal="true" aria-label="Contents navigation">
      <div class="mobile-drawer">
        <div class="mobile-drawer-head">
          {hasToc && hasSiblingTree ? (
            <div class="drawer-tabs" role="tablist">
              <button
                type="button"
                class="drawer-tab active"
                data-drawer-tab="toc"
                role="tab"
                aria-selected="true"
              >
                On this page
              </button>
              <button
                type="button"
                class="drawer-tab"
                data-drawer-tab="chapters"
                role="tab"
                aria-selected="false"
              >
                Chapters ({post.siblingTree.totalCount})
              </button>
            </div>
          ) : (
            <span class="drawer-single-title">
              {hasToc ? 'On this page' : post.siblingTree?.label}
            </span>
          )}
          <button
            type="button"
            class="drawer-close-btn"
            id="close-drawer-btn"
            aria-label="Close drawer"
          >
            ×
          </button>
        </div>

        <div class="mobile-drawer-body">
          {hasToc && (
            <div class="drawer-panel" data-drawer-panel="toc">
              <ul class="toc-list">
                {post.headings.map((h: { depth: number; text: string; id: string }) => (
                  <li class={`depth-${h.depth}`}>
                    <a href={`#${h.id}`} class="mobile-toc-link" data-toc-id={h.id}>
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {hasSiblingTree && (
            <div
              class="drawer-panel"
              data-drawer-panel="chapters"
              hidden={hasToc ? true : undefined}
            >
              {post.siblingTree.folders.map((folder: any) => (
                <div class="chapter-folder" data-sidebar-folder>
                  <button
                    type="button"
                    class="chapter-folder-toggle"
                    data-sidebar-folder-toggle
                    aria-expanded="true"
                  >
                    <span class="folder-chevron" aria-hidden="true">▾</span>
                    <span class="chapter-folder-name">{folder.folderName}</span>
                    <span class="chapter-folder-count">{folder.items.length}</span>
                  </button>
                  <ul class="chapter-list">
                    {folder.items.map((item: any, idx: number) => (
                      <li>
                        <a
                          href={withBase(`post/${item.slug}/`)}
                          aria-current={item.slug === post.slug ? 'page' : undefined}
                        >
                          <span class="chapter-item-idx">{String(idx + 1).padStart(2, '0')}</span>
                          <span class="chapter-item-text">{item.title}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  )}

  <script is:inline define:vars={{ hasMermaid: post.hasMermaid }}>
    // 1. Reading Progress Bar, ScrollSpy TOC & Scroll-to-Top Visibility
    const progressBar = document.getElementById('reading-progress-bar');
    const scrollTopBtn = document.getElementById('scroll-top-btn');
    const tocLinks = Array.from(document.querySelectorAll('#toc-list a[data-toc-id], .mobile-drawer a[data-toc-id]'));
    const uniqueHeadingIds = Array.from(new Set(tocLinks.map((a) => a.getAttribute('data-toc-id'))));
    const headingElements = uniqueHeadingIds
      .map((id) => document.getElementById(id))
      .filter(Boolean);

    function onScrollUpdate() {
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      if (progressBar && docHeight > 0) {
        const pct = Math.min(100, Math.max(0, (window.scrollY / docHeight) * 100));
        progressBar.style.width = `${pct}%`;
      }

      if (scrollTopBtn) {
        scrollTopBtn.classList.toggle('visible', window.scrollY > 280);
      }

      if (headingElements.length > 0) {
        let activeId = headingElements[0].id;
        for (const h of headingElements) {
          if (h.getBoundingClientRect().top <= 130) {
            activeId = h.id;
          } else {
            break;
          }
        }
        tocLinks.forEach((link) => {
          link.classList.toggle('active', link.getAttribute('data-toc-id') === activeId);
        });
      }
    }

    window.addEventListener('scroll', onScrollUpdate, { passive: true });
    onScrollUpdate();

    // Auto-scroll active chapter into view inside left sidebar
    const activeChapter = document.querySelector('.chapter-sidebar a[aria-current="page"]');
    activeChapter?.scrollIntoView({ block: 'nearest' });

    // Collapsible folders in chapter sidebar & mobile drawer
    document.querySelectorAll('[data-sidebar-folder-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const folder = btn.closest('[data-sidebar-folder]');
        if (!folder) return;
        const isCollapsed = folder.classList.toggle('collapsed');
        btn.setAttribute('aria-expanded', String(!isCollapsed));
      });
    });

    // 2. Back to Top & Mobile Drawer
    scrollTopBtn?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    const drawerBackdrop = document.getElementById('mobile-drawer-backdrop');
    const closeDrawerBtn = document.getElementById('close-drawer-btn');
    const drawerTabs = Array.from(document.querySelectorAll('[data-drawer-tab]'));
    const drawerPanels = Array.from(document.querySelectorAll('[data-drawer-panel]'));

    function closeDrawer() {
      drawerBackdrop?.classList.remove('open');
    }

    document.getElementById('open-drawer-btn')?.addEventListener('click', () => {
      drawerBackdrop?.classList.add('open');
    });
    closeDrawerBtn?.addEventListener('click', closeDrawer);
    drawerBackdrop?.addEventListener('click', (e) => {
      if (e.target === drawerBackdrop || e.target.closest('.mobile-toc-link')) {
        closeDrawer();
      }
    });

    drawerTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-drawer-tab');
        drawerTabs.forEach((t) => {
          const isCurrent = t === tab;
          t.classList.toggle('active', isCurrent);
          t.setAttribute('aria-selected', String(isCurrent));
        });
        drawerPanels.forEach((panel) => {
          panel.hidden = panel.getAttribute('data-drawer-panel') !== target;
        });
      });
    });

    // 3. On-demand Mermaid Diagram Rendering (with live theme switching)
    if (hasMermaid) {
      const mermaidBlocks = Array.from(document.querySelectorAll('pre.mermaid'));
      mermaidBlocks.forEach((el) => {
        if (!el.dataset.mermaidSrc) {
          el.dataset.mermaidSrc = el.textContent || '';
        }
      });

      function renderMermaidDiagrams() {
        if (!window.mermaid) return;
        const isLight = document.documentElement.dataset.theme === 'light';
        window.mermaid.initialize({
          startOnLoad: false,
          theme: isLight ? 'neutral' : 'dark',
        });
        mermaidBlocks.forEach((el) => {
          if (el.dataset.mermaidSrc) {
            el.removeAttribute('data-processed');
            el.textContent = el.dataset.mermaidSrc;
          }
        });
        window.mermaid.run({ nodes: mermaidBlocks });
      }

      const script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js';
      script.onload = renderMermaidDiagrams;
      document.head.appendChild(script);

      window.addEventListener('theme-changed', renderMermaidDiagrams);
    }
  </script>
</BaseLayout>
